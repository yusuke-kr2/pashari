<div class="page-content">
  <h1 class="page-title"><%= @group.name %></h1>

  <% if @developing_photos.any? %>
    <h2 style="font-size: 0.85rem; font-weight: 600; color: #999; margin-bottom: 10px;">
      <i class="bi bi-hourglass-split"></i> <%= t('.developing') %>
    </h2>
    <div class="photo-grid mb-4">
      <% @developing_photos.each do |photo| %>
        <div class="developing-card" data-controller="countdown" data-countdown-deadline-value="<%= photo.visible_at.iso8601 %>">
          <div>
            <div class="developing-icon"><i class="bi bi-film"></i></div>
            <div class="developing-time">
              <span data-countdown-target="display"><%= t('.remaining_time', time: distance_of_time_in_words(Time.current, photo.visible_at)) %></span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @developed_photos.any? %>
    <% photos_json = @developed_photos.map.with_index do |photo, i|
      {
        url: url_for(photo.image),
        name: photo.user.name,
        date: photo.taken_at ? l(photo.taken_at, format: :short) : ""
      }
    end.to_json %>
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h2 style="font-size: 0.85rem; font-weight: 600; color: #999; margin: 0;">
        <i class="bi bi-check-circle"></i> <%= t('.developed') %>
      </h2>
      <%= link_to download_all_group_photos_path(@group), class: "btn btn-pashari-outline btn-sm" do %>
        <i class="bi bi-file-zip"></i> <%= t('.download_all') %>
      <% end %>
    </div>
    <div class="photo-grid" data-controller="photoviewer" data-photoviewer-photos-value="<%= photos_json %>">
      <% @developed_photos.each_with_index do |photo, i| %>
        <div class="photo-card" data-photoviewer-index="<%= i %>" data-action="click->photoviewer#open" style="cursor: pointer;">
          <%= image_tag photo.image if photo.image.attached? %>
          <div class="photo-info d-flex justify-content-between align-items-center">
            <div>
              <%= photo.user.name %><br>
              <%= l(photo.taken_at, format: :short) if photo.taken_at %>
            </div>
            <%= link_to download_group_photo_path(@group, photo), style: "color: #999;", data: { action: "click->photoviewer#noop" } do %>
              <i class="bi bi-download"></i>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# モーダル %>
      <div data-photoviewer-target="modal" data-action="click->photoviewer#closeOnBackdrop" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.92); z-index: 9999; align-items: center; justify-content: center; flex-direction: column;">
        <button data-action="click->photoviewer#close" style="position: absolute; top: 16px; right: 16px; background: none; border: none; color: #fff; font-size: 1.8rem; cursor: pointer; z-index: 1;">
          <i class="bi bi-x-lg"></i>
        </button>
        <button data-action="click->photoviewer#prev" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: #fff; font-size: 2rem; cursor: pointer; z-index: 1;">
          <i class="bi bi-chevron-left"></i>
        </button>
        <img data-photoviewer-target="image" src="" style="max-width: 96vw; max-height: 80vh; object-fit: contain; border-radius: 4px;">
        <div style="color: #ccc; font-size: 0.8rem; margin-top: 12px; text-align: center;">
          <span data-photoviewer-target="name"></span>
          <span style="margin: 0 8px;">·</span>
          <span data-photoviewer-target="date"></span>
        </div>
        <button data-action="click->photoviewer#next" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: #fff; font-size: 2rem; cursor: pointer; z-index: 1;">
          <i class="bi bi-chevron-right"></i>
        </button>
      </div>
    </div>
  <% end %>

  <% if @developed_photos.empty? && @developing_photos.empty? %>
    <div class="empty-state">
      <div class="empty-icon"><i class="bi bi-camera"></i></div>
      <p class="empty-text"><%= t('.empty') %></p>
    </div>
  <% end %>

  <div class="mt-4">
    <%= link_to t('.back'), group_path(@group), class: "btn btn-pashari-outline w-100" %>
  </div>
</div>
